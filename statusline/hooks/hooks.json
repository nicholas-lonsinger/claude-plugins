{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/statusline-setup.sh",
            "timeout": 10,
            "statusMessage": "Configuring status line"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/statusline-cleanup.sh"
          }
        ]
      }
    ]
  }
}
