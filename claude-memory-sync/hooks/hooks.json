{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-sync.sh pull",
            "timeout": 300,
            "statusMessage": "Syncing memory from origin",
            "async": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/install-check.sh",
            "timeout": 10,
            "statusMessage": "Checking memory sync setup"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-sync.sh push",
            "statusMessage": "Syncing memory to origin",
            "async": true
          }
        ]
      }
    ]
  }
}
