#!/usr/bin/env python3
"""Record judged subagent launches and tally them per task-table row.

  effort-log add --row KEY --level LEVEL --outcome OUTCOME --model ID
                 (--agent ID | --workflow RUN_ID --label LABEL)
                 [--role ROLE] [--pair ID]
  effort-log tally [--model ID]

Row keys and each row's model and current level are read from the task
table in the synced user CLAUDE.md. A row's evidence is the launches on its
model, counted per exact model id, so a new model version starts every
row's evidence fresh. Each session appends to its own TSV in the sync
store, so sessions and machines never write the same file.
"""
import argparse
import csv
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

STORE = Path.home() / ".claude/plugins/data/claude-memory-sync-nicholas-lonsinger-plugins/user"
LOG_DIR = Path(os.environ.get("EFFORT_LOG_DIR", STORE / "effort-log"))
TABLE = Path(os.environ.get("EFFORT_TABLE", STORE / "CLAUDE.md"))

ROW_LEVELS = ["low", "medium", "high"]  # a row's level stays in this range
LEVELS = ROW_LEVELS + ["xhigh"]  # xhigh is reached only by escalation
OUTCOMES = ["met", "missed", "brief", "inconclusive"]
ROLES = ["single", "upper", "lower", "escalation"]
MODELS = ["haiku", "sonnet", "opus", "fable"]  # a row's Model cell; exact ids are claude-<model>-…
ALIASES = set(MODELS) | {"inherit"}

WINDOW = 5  # most recent runs, and most recent pair comparisons, a verdict reads
RAISE_AT = 2  # misses at the row's level within WINDOW that raise it
DROP_AT = 4  # lower-level wins within WINDOW that drop it

# Recorded for later mining; no verdict reads them.
MEASURES = [
    "agent", "requests", "tool_calls",
    "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_5m_tokens", "cache_write_1h_tokens",
    "model_secs", "tool_secs", "idle_secs",
]
COLUMNS = ["time", "model", "row", "level", "role", "pair", "outcome"] + MEASURES
PROJECTS = Path.home() / ".claude/projects"
ROW_RE = re.compile(r"^\|\s*`([a-z0-9-]+)`\s*\|.*\|([^|]*)\|([^|]*)\|\s*$")
# The Effort cell is a level, optionally ", unpaired": the tally never asks to pair that row.
EFFORT_RE = re.compile(r"^(low|medium|high)(, unpaired)?$")


def family(model_id):
    """The Model-cell name an exact id belongs to: claude-opus-5-5 → opus."""
    parts = model_id.split("-")
    return parts[1] if len(parts) > 1 and parts[0] == "claude" else None


def fail(message):
    print(f"effort-log: {message}", file=sys.stderr)
    sys.exit(2)


def read_table():
    try:
        lines = TABLE.read_text().splitlines()
    except OSError as error:
        fail(f"cannot read the task table in {TABLE}: {error}")
    table = {}
    for line in lines:
        match = ROW_RE.match(line)
        if match:
            model = match.group(2).strip()
            if model not in MODELS:
                fail(f"row `{match.group(1)}` in {TABLE}: Model cell {model!r} is not one of {', '.join(MODELS)}")
            effort = EFFORT_RE.match(match.group(3).strip())
            if not effort:
                fail(f"row `{match.group(1)}` in {TABLE}: Effort cell {match.group(3).strip()!r} "
                     "is not low, medium, or high, optionally followed by ', unpaired'")
            table[match.group(1)] = (model, effort.group(1), effort.group(2) is not None)
    if not table:
        fail(f"no task-table rows (| `key` | task | model | effort |) found in {TABLE}")
    return table


def read_log():
    entries = []
    for path in sorted(LOG_DIR.glob("*.tsv")):
        with path.open(newline="") as handle:
            for entry in csv.DictReader(handle, delimiter="\t"):
                entry["session"] = path.stem
                entries.append(entry)
    entries.sort(key=lambda entry: entry["time"])
    return entries


def workflow_agent(session, run_id, label):
    """The agentId of the agent() a Workflow run labeled `label`; main is never shown it."""
    records = list(PROJECTS.glob(f"*/{session}/workflows/{run_id}.json"))
    if len(records) != 1:
        fail(f"no single record for workflow run {run_id} in session {session} under {PROJECTS}")
    agents = [
        step for step in json.loads(records[0].read_text()).get("workflowProgress", [])
        if step.get("type") == "workflow_agent" and step.get("label") == label
    ]
    if len(agents) != 1:
        fail(f"workflow run {run_id} has {len(agents)} agents labeled '{label}'; a logged launch needs exactly one")
    if agents[0].get("cached"):
        fail(f"'{label}' in {run_id} reused an earlier run's result; log it from the run that did the work")
    return agents[0]["agentId"]


def measure_agent(session, agent_id, model):
    """One subagent run's requests, tool calls, tokens by kind, and time split, read from its transcript.

    Transcripts stay on the machine that ran them and are eventually cleaned
    up, so these columns are the only lasting record. The completion
    notification's token count is the final context size and its duration
    includes idle waits, so neither is recorded. Output counts appear to omit
    thinking. Idle is the wait after the run ended its turn until main or a
    peer resumed it; a wait for its own background task is tool time.
    """
    matches = list(PROJECTS.glob(f"*/{session}/subagents/**/agent-{agent_id}.jsonl"))
    if len(matches) != 1:
        fail(f"no single transcript for agent {agent_id} in session {session} under {PROJECTS}")
    with matches[0].open() as handle:
        entries = [json.loads(line) for line in handle]

    ran_on = {
        entry["message"]["model"] for entry in entries
        if entry.get("type") == "assistant" and entry["message"].get("model", "<synthetic>") != "<synthetic>"
    }
    if ran_on != {model}:
        fail(f"--model is {model}, but agent {agent_id}'s transcript ran on {', '.join(sorted(ran_on)) or 'nothing'}")

    # A request streams as several entries sharing one message id; each
    # field's largest value across them is the request's usage.
    requests = {}
    tool_calls = set()
    for entry in entries:
        message = entry.get("message")
        if not isinstance(message, dict):
            continue
        if isinstance(message.get("content"), list):
            tool_calls |= {block["id"] for block in message["content"] if block.get("type") == "tool_use"}
        usage = message.get("usage")
        if not usage:
            continue
        split = usage.get("cache_creation") or {}
        seen = {
            "input_tokens": usage.get("input_tokens") or 0,
            "output_tokens": usage.get("output_tokens") or 0,
            "cache_read_tokens": usage.get("cache_read_input_tokens") or 0,
            "cache_write_5m_tokens": split.get("ephemeral_5m_input_tokens", usage.get("cache_creation_input_tokens") or 0),
            "cache_write_1h_tokens": split.get("ephemeral_1h_input_tokens") or 0,
        }
        prior = requests.get(message.get("id"), {})
        requests[message.get("id")] = {k: max(v, prior.get(k, 0)) for k, v in seen.items()}

    secs = {"model_secs": 0.0, "tool_secs": 0.0, "idle_secs": 0.0}
    stamped = [e for e in entries if e.get("timestamp")]
    for before, after in zip(stamped, stamped[1:]):
        content = (before.get("message") or {}).get("content")
        turn_ended = before.get("type") == "assistant" and not (
            isinstance(content, list) and any(block.get("type") == "tool_use" for block in content))
        woken_by = (after.get("origin") or {}).get("kind")
        if after.get("type") == "assistant":
            bucket = "model_secs"
        elif turn_ended and woken_by != "task-notification":
            bucket = "idle_secs"
        else:
            bucket = "tool_secs"
        start = datetime.fromisoformat(before["timestamp"].replace("Z", "+00:00"))
        end = datetime.fromisoformat(after["timestamp"].replace("Z", "+00:00"))
        secs[bucket] += (end - start).total_seconds()

    totals = {k: sum(r[k] for r in requests.values()) for k in MEASURES[3:8]}
    return {
        "agent": agent_id, "requests": len(requests), "tool_calls": len(tool_calls),
        **totals, **{k: round(v) for k, v in secs.items()},
    }


def level_below(level):
    index = ROW_LEVELS.index(level)
    return ROW_LEVELS[index - 1] if index > 0 else None


def level_above(level):
    index = ROW_LEVELS.index(level)
    return ROW_LEVELS[index + 1] if index + 1 < len(ROW_LEVELS) else None


def evaluate(entries, row, level, model, pairable=True):
    mine = [e for e in entries if e["row"] == row and e["model"] == model]

    runs = [
        e for e in mine
        if e["role"] in ("single", "upper") and e["level"] == level and e["outcome"] in ("met", "missed")
    ][-WINDOW:]
    misses = sum(e["outcome"] == "missed" for e in runs)

    below = level_below(level)
    pairs = {}
    for e in mine:
        if e["role"] in ("upper", "lower"):
            pairs.setdefault((e["session"], e["pair"]), {})[e["role"]] = e
    comparisons = []
    for pair in pairs.values():
        upper, lower = pair.get("upper"), pair.get("lower")
        if not upper or not lower or upper["level"] != level or lower["level"] != below:
            continue
        if {upper["outcome"], lower["outcome"]} & {"brief", "inconclusive"}:
            continue
        comparisons.append(lower["outcome"] == "met")
    comparisons = comparisons[-WINDOW:]
    wins = sum(comparisons)

    if misses >= RAISE_AT and level_above(level):
        verdict = "raise"
        reason = f"{misses} of the last {len(runs)} runs at {level} missed"
    elif below and wins >= DROP_AT:
        verdict = "drop"
        reason = f"{below} met Done in {wins} of the last {len(comparisons)} pairs"
    elif below and pairable and len(comparisons) < WINDOW:
        verdict = "probe"
        reason = f"{len(comparisons)} of {WINDOW} pair comparisons against {below}"
    else:
        verdict = "hold"
        reason = ""

    return {
        "verdict": verdict,
        "reason": reason,
        "runs": len(runs),
        "misses": misses,
        "pairs": len(comparisons),
        "wins": wins,
        "briefs": sum(e["outcome"] == "brief" for e in mine),
    }


def command_add(args):
    table = read_table()
    if args.row not in table:
        fail(f"unknown row '{args.row}'; add it to the task table first. Rows: {', '.join(table)}")
    if args.model.lower() in ALIASES or not args.model.startswith("claude-"):
        fail(f"--model takes the exact model id (claude-…), not '{args.model}'")
    row_model = table[args.row][0]
    if family(args.model) != row_model:
        fail(f"row '{args.row}' runs on {row_model}, so a run on {args.model} is not its evidence; "
             "a launch and its escalation stay on the row's model")
    if (args.role in ("upper", "lower")) != bool(args.pair):
        fail("--pair is required for --role upper/lower and only for them")
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session:
        fail("CLAUDE_CODE_SESSION_ID is not set; run this from a Claude Code session")
    if bool(args.workflow) != bool(args.label):
        fail("--workflow and --label go together")
    agent_id = args.agent or workflow_agent(session, args.workflow, args.label)
    if any(entry.get("agent") == agent_id for entry in read_log()):
        fail(f"agent {agent_id} is already logged; a launch is logged once, when its Done is judged")
    measured = measure_agent(session, agent_id, args.model)

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    path = LOG_DIR / f"{session}.tsv"
    new_file = not path.exists()
    with path.open("a", newline="") as handle:
        writer = csv.writer(handle, delimiter="\t", lineterminator="\n")
        if new_file:
            writer.writerow(COLUMNS)
        writer.writerow([
            datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            args.model, args.row, args.level, args.role, args.pair or "",
            args.outcome, *(measured[m] for m in MEASURES),
        ])

    _, level, unpaired = table[args.row]
    result = evaluate(read_log(), args.row, level, args.model, not unpaired)
    print(f"logged {args.row} {args.level} {args.role} {args.outcome}: {measured['requests']} requests, "
          f"{measured['model_secs']}s model, {measured['tool_secs']}s tools, {measured['idle_secs']}s idle")
    if result["verdict"] == "raise":
        target = level_above(level)
    elif result["verdict"] == "drop":
        target = level_below(level)
    else:
        return
    print(f"LEVEL CHANGE: {args.row} {level} → {target} ({result['reason']}). "
          f"Set that row's Effort cell to {target} in {TABLE}.")


def command_tally(args):
    table = read_table()
    entries = read_log()
    if args.model and not family(args.model):
        fail(f"--model takes the exact model id (claude-…), not '{args.model}'")
    print(f"{'row':<17}{'model':<20}{'level':<8}{'runs':>6}{'miss':>6}{'pairs':>7}{'won':>5}{'brief':>7}  verdict")
    for row, (row_model, level, unpaired) in table.items():
        if args.model and family(args.model) == row_model:
            model = args.model
        else:
            logged = [e["model"] for e in entries if e["row"] == row and family(e["model"]) == row_model]
            model = logged[-1] if logged else None
        if not model:
            print(f"{row:<17}{row_model:<20}{level:<8}  nothing logged on {row_model} yet")
            continue
        r = evaluate(entries, row, level, model, not unpaired)
        detail = f" — {r['reason']}" if r["reason"] else ""
        print(f"{row:<17}{model:<20}{level:<8}{r['runs']:>6}{r['misses']:>6}{r['pairs']:>7}{r['wins']:>5}"
              f"{r['briefs']:>7}  {r['verdict']}{detail}")
    orphans = sorted({e["row"] for e in entries} - set(table))
    if orphans:
        print(f"logged rows no longer in the table: {', '.join(orphans)}")


def main():
    if not STORE.is_dir():
        fail(f"the orchestration plugin's effort log needs the claude-memory-sync plugin installed ({STORE} is missing); run /claude-memory-sync:install")
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)

    add = commands.add_parser("add", help="record one judged launch")
    add.add_argument("--row", required=True, help="task-table row key")
    add.add_argument("--level", required=True, choices=LEVELS, help="effort the run used")
    add.add_argument("--outcome", required=True, choices=OUTCOMES)
    add.add_argument("--model", required=True, help="exact model id the subagent ran on")
    add.add_argument("--role", default="single", choices=ROLES)
    add.add_argument("--pair", help="id shared by a pair's upper and lower runs")
    launch = add.add_mutually_exclusive_group(required=True)
    launch.add_argument("--agent", help="the agentId an Agent launch returned; its transcript supplies the recorded measures")
    launch.add_argument("--workflow", help="the Run ID of the Workflow whose agent() this was; pair with --label")
    add.add_argument("--label", help="the label the Workflow script gave that agent()")
    add.set_defaults(handler=command_add)

    tally = commands.add_parser("tally", help="per-row evidence and verdicts")
    tally.add_argument("--model", help="exact model id to tally the rows on its model with "
                                        "(default: each row's newest logged id on its model)")
    tally.set_defaults(handler=command_tally)

    args = parser.parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
