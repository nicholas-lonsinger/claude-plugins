#!/usr/bin/env python3
"""Record judged subagent launches and move each task-table row's setting on the evidence.

  effort-log add --row KEY --level LEVEL --outcome OUTCOME --model ID
                 (--agent ID | --workflow RUN_ID --label LABEL)
                 [--role single|escalation] [--note TEXT]
  effort-log tally

The task table in the synced user CLAUDE.md (| `key` | task | oracle | model
| effort |) gives each row its oracle and its setting: a model family and an
effort level. A row's evidence at a setting is its judged runs there (met or
missed), across every version of the family, so a new version inherits the
previous one's evidence and level; brief and inconclusive runs count for
nothing. Each row's verdict is an action:

- step up, back to the setting it came from, when a row stepped down misses
  within its first STREAK runs there; or, when RAISE_AT of the last WINDOW
  runs at its setting missed, to the setting it came from if that is above,
  else one rung up (effort first, then the next model on the haiku < sonnet
  < opus chain). Missing at the top of the ladder holds for refresh-ladder.
- step down, on an oracle row only, one rung (effort first, then the model
  below) once the streak of met runs since the row reached its setting is
  STREAK x 2^(misses at the rung on the family's newest logged version).
- hold otherwise. A row without an oracle moves down only by refresh-ladder.

The log never moves a row onto or off fable; a fable row steps effort only.
`add` logs a run, then rewrites the row's Model and Effort cells when the
verdict steps. `tally` prints every row's verdict and the rows whose recent
runs keep missing for the brief. Each session appends to its own TSV in the
sync store, so sessions and machines never write the same file.
"""
import argparse
import csv
import json
import os
import re
import shutil
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

STORE = Path.home() / ".claude/plugins/data/claude-memory-sync-nicholas-lonsinger-plugins/user"
LOG_DIR_SET = os.environ.get("EFFORT_LOG_DIR")
TABLE_SET = os.environ.get("EFFORT_TABLE")
LOG_DIR = Path(LOG_DIR_SET) if LOG_DIR_SET else STORE / "effort-log"
TABLE = Path(TABLE_SET) if TABLE_SET else STORE / "CLAUDE.md"

LEVELS = ["low", "medium", "high", "xhigh"]  # xhigh is reached only by escalation
ROW_LEVELS = LEVELS[:3]
CHAIN = ["haiku", "sonnet", "opus"]  # the models a row steps along
MODELS = CHAIN + ["fable"]  # a row's Model cell; exact ids are claude-<model>-…; fable ranks above opus
ALIASES = set(MODELS) | {"inherit"}
ORACLES = ["yes", "no"]
OUTCOMES = ["met", "missed", "brief", "inconclusive"]
JUDGED = ("met", "missed")
ROLES = ["single", "escalation"]  # roles `add` records; legacy entries also carry upper and lower
OFF_TENURE = ("escalation", "lower")  # side runs at another setting, never the row's own line

STREAK = 5  # met runs a step down needs, doubled per miss at the rung below on the current version
WINDOW = 5  # most recent runs at a setting that a step up reads
RAISE_AT = 2  # misses within WINDOW that step a row up
BRIEF_SPAN = 20  # most recent entries of a row that the brief-miss check reads
BRIEF_AT = 2  # brief misses within BRIEF_SPAN that flag a row

# Recorded for later mining; no verdict reads them.
MEASURES = [
    "agent", "requests", "tool_calls",
    "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_5m_tokens", "cache_write_1h_tokens",
    "model_secs", "tool_secs", "idle_secs",
]
COLUMNS = ["time", "model", "row", "level", "role", "outcome", "note"] + MEASURES
PROJECTS = Path.home() / ".claude/projects"
ROW_RE = re.compile(
    r"^\|\s*`(?P<key>[a-z0-9-]+)`\s*\|.*\|(?P<oracle>[^|]*)\|(?P<model>[^|]*)\|(?P<effort>[^|]*)\|\s*$")


def family(model_id):
    """The Model-cell name an exact id belongs to: claude-opus-5-5 → opus."""
    parts = model_id.split("-")
    return parts[1] if len(parts) > 1 and parts[0] == "claude" else None


def name(setting):
    return f"{setting[0]} {setting[1]}"


def fail(message):
    print(f"effort-log: {message}", file=sys.stderr)
    sys.exit(2)


def read_table():
    """Each row's oracle (bool) and setting (family, level), keyed by row."""
    try:
        lines = TABLE.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        fail(f"cannot read the task table in {TABLE}: {error}")
    table = {}
    for line in lines:
        match = ROW_RE.match(line)
        if not match:
            continue
        key = match.group("key")
        cells = {cell: match.group(cell).strip() for cell in ("oracle", "model", "effort")}
        for cell, allowed in (("oracle", ORACLES), ("model", MODELS), ("effort", ROW_LEVELS)):
            if cells[cell] not in allowed:
                fail(f"row `{key}` in {TABLE}: {cell.capitalize()} cell {cells[cell]!r} "
                     f"is not one of {', '.join(allowed)}")
        if key in table:
            fail(f"row `{key}` appears more than once in {TABLE}")
        table[key] = {"oracle": cells["oracle"] == "yes", "setting": (cells["model"], cells["effort"])}
    if not table:
        fail(f"no task-table rows (| `key` | task | oracle | model | effort |) found in {TABLE}")
    return table


def recell(cell, value):
    """`cell` with its content replaced by `value`, its padding kept."""
    return cell[:len(cell) - len(cell.lstrip())] + value + cell[len(cell.rstrip()):]


def write_atomically(target, text):
    """Replace `target` with `text` through a temp file beside it, keeping its mode."""
    fd, temp = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
            handle.write(text)
        shutil.copymode(target, temp)
        os.replace(temp, target)
    except BaseException:
        os.unlink(temp)
        raise


def rewrite_row(row, setting):
    """Set `row`'s Model and Effort cells in the table to `setting`; every other byte stays."""
    target = TABLE.resolve()
    with target.open(encoding="utf-8", newline="") as handle:
        lines = handle.read().splitlines(keepends=True)
    for index, line in enumerate(lines):
        body = line.rstrip("\r\n")
        match = ROW_RE.match(body)
        if match and match.group("key") == row:
            body = (body[:match.start("model")] + recell(match.group("model"), setting[0]) + "|"
                    + recell(match.group("effort"), setting[1]) + body[match.end("effort"):])
            lines[index] = body + line[len(line.rstrip("\r\n")):]
    write_atomically(target, "".join(lines))


def read_log():
    entries = []
    for path in sorted(LOG_DIR.glob("*.tsv")):
        with path.open(encoding="utf-8", newline="") as handle:
            for entry in csv.DictReader(handle, delimiter="\t"):
                entry["session"] = path.stem
                entry["role"] = entry.get("role") or "single"
                entry["note"] = entry.get("note") or ""
                entries.append(entry)
    entries.sort(key=lambda entry: entry["time"])
    return entries


def append_entry(path, values):
    """Append one entry to a session's TSV, first moving a file with older columns onto COLUMNS."""
    header = None
    if path.exists():
        with path.open(encoding="utf-8", newline="") as handle:
            reader = csv.DictReader(handle, delimiter="\t")
            rows = list(reader)
            header = reader.fieldnames
    if header and header[:len(COLUMNS)] != COLUMNS:
        header = COLUMNS + [column for column in header if column not in COLUMNS]
        lines = [header] + [[row.get(column) or "" for column in header] for row in rows]
        write_atomically(path, "".join("\t".join(line) + "\n" for line in lines))
    with path.open("a", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=header or COLUMNS, delimiter="\t",
                                lineterminator="\n", restval="")
        if not header:
            writer.writeheader()
        writer.writerow(values)


def workflow_agent(session, run_id, label):
    """The agentId of the agent() a Workflow run labeled `label`; main is never shown it."""
    records = list(PROJECTS.glob(f"*/{session}/workflows/{run_id}.json"))
    if len(records) != 1:
        fail(f"no single record for workflow run {run_id} in session {session} under {PROJECTS}")
    agents = [
        step for step in json.loads(records[0].read_text()).get("workflowProgress", [])
        if step.get("type") == "workflow_agent" and step.get("label") == label
    ]
    if len(agents) != 1:
        fail(f"workflow run {run_id} has {len(agents)} agents labeled '{label}'; a logged launch needs exactly one")
    if agents[0].get("cached"):
        fail(f"'{label}' in {run_id} reused an earlier run's result; log it from the run that did the work")
    return agents[0]["agentId"]


def measure_agent(session, agent_id, model):
    """One subagent run's requests, tool calls, tokens by kind, and time split, read from its transcript.

    Transcripts stay on the machine that ran them and are eventually cleaned
    up, so these columns are the only lasting record. The completion
    notification's token count is the final context size and its duration
    includes idle waits, so neither is recorded. Output counts appear to omit
    thinking. Idle is the wait after the run ended its turn until main or a
    peer resumed it; a wait for its own background task is tool time.
    """
    matches = list(PROJECTS.glob(f"*/{session}/subagents/**/agent-{agent_id}.jsonl"))
    if len(matches) != 1:
        fail(f"no single transcript for agent {agent_id} in session {session} under {PROJECTS}")
    with matches[0].open() as handle:
        entries = [json.loads(line) for line in handle]

    ran_on = {
        entry["message"]["model"] for entry in entries
        if entry.get("type") == "assistant" and entry["message"].get("model", "<synthetic>") != "<synthetic>"
    }
    if ran_on != {model}:
        fail(f"--model is {model}, but agent {agent_id}'s transcript ran on {', '.join(sorted(ran_on)) or 'nothing'}")

    # A request streams as several entries sharing one message id; each
    # field's largest value across them is the request's usage.
    requests = {}
    tool_calls = set()
    for entry in entries:
        message = entry.get("message")
        if not isinstance(message, dict):
            continue
        if isinstance(message.get("content"), list):
            tool_calls |= {block["id"] for block in message["content"] if block.get("type") == "tool_use"}
        usage = message.get("usage")
        if not usage:
            continue
        split = usage.get("cache_creation") or {}
        seen = {
            "input_tokens": usage.get("input_tokens") or 0,
            "output_tokens": usage.get("output_tokens") or 0,
            "cache_read_tokens": usage.get("cache_read_input_tokens") or 0,
            "cache_write_5m_tokens": split.get("ephemeral_5m_input_tokens", usage.get("cache_creation_input_tokens") or 0),
            "cache_write_1h_tokens": split.get("ephemeral_1h_input_tokens") or 0,
        }
        prior = requests.get(message.get("id"), {})
        requests[message.get("id")] = {k: max(v, prior.get(k, 0)) for k, v in seen.items()}

    secs = {"model_secs": 0.0, "tool_secs": 0.0, "idle_secs": 0.0}
    stamped = [e for e in entries if e.get("timestamp")]
    for before, after in zip(stamped, stamped[1:]):
        content = (before.get("message") or {}).get("content")
        turn_ended = before.get("type") == "assistant" and not (
            isinstance(content, list) and any(block.get("type") == "tool_use" for block in content))
        woken_by = (after.get("origin") or {}).get("kind")
        if after.get("type") == "assistant":
            bucket = "model_secs"
        elif turn_ended and woken_by != "task-notification":
            bucket = "idle_secs"
        else:
            bucket = "tool_secs"
        start = datetime.fromisoformat(before["timestamp"].replace("Z", "+00:00"))
        end = datetime.fromisoformat(after["timestamp"].replace("Z", "+00:00"))
        secs[bucket] += (end - start).total_seconds()

    totals = {k: sum(r[k] for r in requests.values()) for k in MEASURES[3:8]}
    return {
        "agent": agent_id, "requests": len(requests), "tool_calls": len(tool_calls),
        **totals, **{k: round(v) for k, v in secs.items()},
    }


def setting_of(entry):
    return (family(entry["model"]), entry["level"])


def above(x, s):
    """Whether setting x is above setting s: no lower a model (fable ranks top) and no lower a level."""
    return (x != s and MODELS.index(x[0]) >= MODELS.index(s[0])
            and LEVELS.index(x[1]) >= LEVELS.index(s[1]))


def steppable(s, t):
    """Whether the log may move a row from setting s to t: a row level, and never onto or off fable."""
    return t[1] in ROW_LEVELS and (t[0] == "fable") == (s[0] == "fable")


def rung_up(setting):
    model, level = setting
    if level != ROW_LEVELS[-1]:
        return (model, ROW_LEVELS[ROW_LEVELS.index(level) + 1])
    if model in CHAIN[:-1]:
        return (CHAIN[CHAIN.index(model) + 1], level)
    return None


def rungs_down(setting):
    """The settings a step down may take, nearest first: effort down, then the model below."""
    model, level = setting
    rungs = []
    if level != ROW_LEVELS[0]:
        rungs.append((model, ROW_LEVELS[ROW_LEVELS.index(level) - 1]))
    if model in CHAIN[1:]:
        rungs.append((CHAIN[CHAIN.index(model) - 1], level))
    return rungs


def evaluate(entries, row, setting, oracle):
    """The row's verdict (hold, step down, step up), its target setting, the reason, and the counts behind it."""
    current = {}  # family → the model id of its newest entry anywhere in the log
    for entry in entries:
        current[family(entry["model"])] = entry["model"]
    judged = [
        e for e in entries
        if e["row"] == row and e["outcome"] in JUDGED and family(e["model"]) in MODELS and e["level"] in LEVELS
    ]

    # The tenure: the row's own runs since it reached this setting.
    line = [e for e in judged if e["role"] not in OFF_TENURE]
    start = len(line)
    while start and setting_of(line[start - 1]) == setting:
        start -= 1
    tenure = line[start:]
    prev = setting_of(line[start - 1]) if start else None
    streak = 0
    for entry in reversed(tenure):
        if entry["outcome"] != "met":
            break
        streak += 1
    window = [e for e in judged if setting_of(e) == setting][-WINDOW:]
    misses = sum(e["outcome"] == "missed" for e in window)
    counts = {"tenure": len(tenure), "streak": streak, "misses": misses, "window": len(window)}

    def verdict(action, target, reason):
        return {"verdict": action, "target": target, "reason": reason, **counts}

    back_up = prev is not None and above(prev, setting) and steppable(setting, prev)
    if back_up and any(e["outcome"] == "missed" for e in tenure[:STREAK]):
        return verdict("step up", prev, f"a miss within the first {STREAK} runs at {name(setting)}, "
                                        f"stepped down from {name(prev)}")
    if misses >= RAISE_AT:
        why = f"{misses} of the last {len(window)} runs at {name(setting)} missed"
        target = prev if back_up else rung_up(setting)
        if target is None:
            return verdict("hold", None, f"{why}, at the top of the ladder: refresh-ladder decides")
        return verdict("step up", target, why)
    if not oracle:
        return verdict("hold", None, "no oracle: refresh-ladder sets it")
    rungs = rungs_down(setting)
    if not rungs:
        return verdict("hold", None, f"streak {streak}, at the floor: no lower setting")
    needs = []
    for rung in rungs:
        misses_now = sum(
            e["outcome"] == "missed" and e["model"] == current.get(rung[0])
            for e in judged if setting_of(e) == rung
        )
        need = STREAK * 2 ** misses_now
        if streak >= need:
            return verdict("step down", rung, f"streak {streak} of {need} for {name(rung)}")
        needs.append(need)
    return verdict("hold", None, f"streak {streak} of {needs[0]} for {name(rungs[0])}")


def command_add(args):
    table = read_table()
    if args.row not in table:
        fail(f"unknown row '{args.row}'; add it to the task table first. Rows: {', '.join(table)}")
    if args.model.lower() in ALIASES or family(args.model) not in MODELS:
        fail(f"--model takes the exact model id (claude-<{'|'.join(MODELS)}>-…), not '{args.model}'")
    note = " ".join((args.note or "").split())
    if args.outcome == "brief" and not note:
        fail("--outcome brief takes --note: what the brief lacked")
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session:
        fail("CLAUDE_CODE_SESSION_ID is not set; run this from a Claude Code session")
    if bool(args.workflow) != bool(args.label):
        fail("--workflow and --label go together")
    agent_id = args.agent or workflow_agent(session, args.workflow, args.label)
    if any(entry.get("agent") == agent_id for entry in read_log()):
        fail(f"agent {agent_id} is already logged; a launch is logged once, when its Done is judged")
    measured = measure_agent(session, agent_id, args.model)

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    append_entry(LOG_DIR / f"{session}.tsv", {
        "time": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "model": args.model, "row": args.row, "level": args.level, "role": args.role,
        "outcome": args.outcome, "note": note, **measured,
    })
    print(f"logged {args.row} {args.level} {args.role} {args.outcome}: {measured['requests']} requests, "
          f"{measured['model_secs']}s model, {measured['tool_secs']}s tools, {measured['idle_secs']}s idle")

    spec = table[args.row]
    result = evaluate(read_log(), args.row, spec["setting"], spec["oracle"])
    if result["verdict"] == "hold":
        return
    rewrite_row(args.row, result["target"])
    print(f"{result['verdict'].upper()}: {args.row} {name(spec['setting'])} → {name(result['target'])} "
          f"({result['reason']}); the table now says so.")


def command_tally(args):
    table = read_table()
    entries = read_log()
    width = max(len("row"), *map(len, table)) + 2
    print(f"{'row':<{width}}{'oracle':<8}{'setting':<15}{'tenure':>7}{'streak':>8}{'misses':>8}  verdict")
    for row, spec in table.items():
        r = evaluate(entries, row, spec["setting"], spec["oracle"])
        action = r["verdict"] + (f" → {name(r['target'])}" if r["target"] else "")
        misses = f"{r['misses']}/{r['window']}"
        print(f"{row:<{width}}{'yes' if spec['oracle'] else 'no':<8}{name(spec['setting']):<15}"
              f"{r['tenure']:>7}{r['streak']:>8}{misses:>8}  {action} ({r['reason']})")

    for row in table:
        recent = [e for e in entries if e["row"] == row][-BRIEF_SPAN:]
        briefs = [e for e in recent if e["outcome"] == "brief"]
        if len(briefs) < BRIEF_AT:
            continue
        print(f"brief misses: {row} {len(briefs)} of the last {len(recent)} runs")
        for entry in briefs:
            if entry["note"]:
                print(f"  {row}: {entry['note']}")

    orphans = sorted({e["row"] for e in entries} - set(table))
    if orphans:
        print(f"logged rows no longer in the table: {', '.join(orphans)}")


def main():
    if not (LOG_DIR_SET and TABLE_SET) and not STORE.is_dir():
        fail(f"the orchestration plugin's effort log needs the claude-memory-sync plugin installed ({STORE} is missing); run /claude-memory-sync:install")
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)

    add = commands.add_parser("add", help="record one judged launch, and step its row when the evidence says so")
    add.add_argument("--row", required=True, help="task-table row key")
    add.add_argument("--level", required=True, choices=LEVELS, help="effort the run used")
    add.add_argument("--outcome", required=True, choices=OUTCOMES)
    add.add_argument("--model", required=True, help="exact model id the subagent ran on")
    add.add_argument("--role", default="single", choices=ROLES,
                     help="escalation for the rerun a level up after a miss")
    add.add_argument("--note", help="what the brief lacked (required with --outcome brief)")
    launch = add.add_mutually_exclusive_group(required=True)
    launch.add_argument("--agent", help="the agentId an Agent launch returned; its transcript supplies the recorded measures")
    launch.add_argument("--workflow", help="the Run ID of the Workflow whose agent() this was; pair with --label")
    add.add_argument("--label", help="the label the Workflow script gave that agent()")
    add.set_defaults(handler=command_add)

    tally = commands.add_parser("tally", help="every row's verdict, and rows with recurring brief misses")
    tally.set_defaults(handler=command_tally)

    args = parser.parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
