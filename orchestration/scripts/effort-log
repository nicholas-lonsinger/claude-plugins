#!/usr/bin/env python3
"""Record judged subagent launches, and derive each task-table row's setting from the log.

  effort-log add --row KEY --level LEVEL --outcome OUTCOME --model ID
                 (--agent ID | --workflow RUN_ID --label LABEL)
                 [--role single|escalation] [--note TEXT]
  effort-log baseline --row KEY --model FAMILY --level LEVEL --note TEXT [--carry]
  effort-log baseline --from-table --note TEXT [--carry]
  effort-log tally
  effort-log settings

Each session appends to its own TSV in the sync store, so sessions and
machines never write the same file. A log entry is a run (a judged launch on
an exact model id) or a baseline (a row's setting, a model family and an
effort level, as refresh-ladder or the user sets it). The script never writes
the task table, which supplies only each row's key and Oracle (and, for
`baseline --from-table`, its Model and Effort cells).

A row's setting is computed afresh on every read from the set of its entries,
never from their order of arrival:

- Evidence. The row's latest baseline B starts it. A `fresh` baseline's
  evidence is the row's runs stamped after it; a `carry` baseline's is all of
  the row's runs. Every met or missed run counts at the setting it ran at
  (its model's family and its level), whatever its role or version.
- Up. From B, while the setting is failing (RAISE_AT misses among its last
  WINDOW runs, the latest a miss), move one rung up: effort first, then the
  next model on the haiku < sonnet < opus chain. Failing at the top of the
  ladder holds for refresh-ladder.
- Down, on an oracle row only. Move to the first of effort down or the model
  below, C, whose need the streak reaches, and repeat from there. The streak
  is the met runs at the current setting S after the latest miss at S or at
  any setting that dominates C but not S; the need is STREAK x 2^(the misses
  at those settings). A failed setting so bounds every setting it dominates,
  and each retry of it waits for twice the streak, counted afresh.

The log never moves a row onto or off fable. `brief` and `inconclusive` runs
and xhigh runs move nothing; recurring brief misses are flagged by `tally`. A
log line that is not UTF-8, does not parse against its file's header, or has
a time that does not parse is skipped and reported by every command.
`settings` prints every row's setting for a SessionStart hook, or what keeps
it from doing so and what fixes it.
"""
import argparse
import csv
import io
import json
import os
import shutil
import sys
import tempfile
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

STORE = Path.home() / ".claude/plugins/data/claude-memory-sync-nicholas-lonsinger-plugins/user"
LOG_DIR_SET = os.environ.get("EFFORT_LOG_DIR")
TABLE_SET = os.environ.get("EFFORT_TABLE")
LOG_DIR = Path(LOG_DIR_SET) if LOG_DIR_SET else STORE / "effort-log"
TABLE = Path(TABLE_SET) if TABLE_SET else STORE / "CLAUDE.md"

LEVELS = ["low", "medium", "high", "xhigh"]  # xhigh is reached only by escalation
ROW_LEVELS = LEVELS[:3]
CHAIN = ["haiku", "sonnet", "opus"]  # the models a row steps along
MODELS = CHAIN + ["fable"]  # model families, in rank order; exact ids are claude-<family>-<version…>
SETTINGS = [(model, level) for model in MODELS for level in ROW_LEVELS]
ALIASES = set(MODELS) | {"inherit"}
ORACLES = ["yes", "no"]
OUTCOMES = ["met", "missed", "brief", "inconclusive"]
JUDGED = ("met", "missed")
ROLES = ["single", "escalation"]  # roles `add` records; legacy entries also carry upper and lower
BASELINE_ROLES = ["fresh", "carry"]
UNPAIRED = ", unpaired"  # an Effort-cell suffix that names no level

STREAK = 5  # met runs a step down needs, doubled per miss at the target or a setting that bears on it
WINDOW = 5  # most recent runs at a setting that the failing check reads
RAISE_AT = 2  # misses within WINDOW that make a setting failing
BRIEF_SPAN = 20  # most recent runs of a row that the brief-miss check reads
BRIEF_AT = 2  # brief misses within BRIEF_SPAN that flag a row

TOP = "misses at the top of its ladder: refresh-ladder sets it"
NO_ORACLE = "no oracle: refresh-ladder sets it"
FLOOR = "at the floor"
NO_BASELINE = "no row has a baseline yet: run effort-log baseline --from-table"

# Recorded for later mining; no verdict reads them.
MEASURES = [
    "agent", "requests", "tool_calls",
    "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_5m_tokens", "cache_write_1h_tokens",
    "model_secs", "tool_secs", "idle_secs",
]
COLUMNS = ["time", "kind", "model", "row", "level", "role", "outcome", "note"] + MEASURES
PROJECTS = Path.home() / ".claude/projects"


def family(model_id):
    """The family an exact id belongs to: claude-opus-5-5 → opus."""
    parts = model_id.split("-")
    return parts[1] if len(parts) > 1 and parts[0] == "claude" else None


def name(setting):
    return f"{setting[0]} {setting[1]}"


class Refusal(Exception):
    """A problem with the input, the table or the log; main prints it and exits 2."""


def fail(message):
    raise Refusal(message)


def store_missing():
    """Whether the sync store the default paths live in is missing (tests and tools set both paths instead)."""
    return not (LOG_DIR_SET and TABLE_SET) and not STORE.is_dir()


STORE_MISSING = (f"the orchestration plugin's effort log needs the claude-memory-sync plugin installed "
                 f"({STORE} is missing); run /claude-memory-sync:install")


def cells_of(line):
    """The cells of a markdown table line, stripped, or None for a line that is not one."""
    line = line.strip()
    if not (line.startswith("|") and line.endswith("|") and len(line) > 1):
        return None
    return [cell.strip() for cell in line[1:-1].split("|")]


def is_key(cell):
    return len(cell) > 2 and cell[0] == cell[-1] == "`"


def read_table():
    """The task table's rows, in order: key → {oracle, model, effort} (model and effort None without the column)."""
    try:
        lines = TABLE.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as error:
        fail(f"cannot read the task table in {TABLE}: {error}")
    columns = None
    table = {}
    for line in lines:
        cells = cells_of(line)
        if columns is None:
            if cells and "Row" in cells and "Oracle" in cells:
                columns = cells
            continue
        if cells is None:
            break  # the table ends at its first non-table line
        if len(cells) != len(columns):
            at = columns.index("Row")
            named = f"row {cells[at]}" if at < len(cells) and is_key(cells[at]) else "a task-table line"
            fail(f"{named} in {TABLE} has {len(cells)} cells where its header has {len(columns)} "
                 f"(a | inside a cell splits it): {line.strip()}")
        row = dict(zip(columns, cells))
        key = row["Row"]
        if not is_key(key):
            continue  # the separator line, or a row without a key
        key = key[1:-1]
        if row["Oracle"] not in ORACLES:
            fail(f"row `{key}` in {TABLE}: Oracle cell {row['Oracle']!r} is not one of {', '.join(ORACLES)}")
        if key in table:
            fail(f"row `{key}` appears more than once in {TABLE}")
        table[key] = {"oracle": row["Oracle"] == "yes", "model": row.get("Model"), "effort": row.get("Effort")}
    if columns is None:
        fail(f"no task-table header with Row and Oracle columns found in {TABLE}")
    if not table:
        fail(f"the task table in {TABLE} has no | `key` | … | rows")
    return table


def write_atomically(target, data):
    """Replace `target` with the bytes `data` through a temp file beside it, keeping its mode."""
    fd, temp = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        shutil.copymode(target, temp)
        os.replace(temp, target)
    except BaseException:
        os.unlink(temp)
        raise


def parse_time(text):
    """An entry's time as an aware datetime, or None when it does not parse."""
    try:
        moment = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    return moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)


def split_lines(data):
    """A file's lines as (number, bytes), without their line endings; a final empty line is no line."""
    lines = data.split(b"\n")
    if lines and lines[-1] == b"":
        lines.pop()
    return [(number, line[:-1] if line.endswith(b"\r") else line) for number, line in enumerate(lines, 1)]


def parse_line(raw, header):
    """One body line as a dict over `header`, or (None, why it does not parse)."""
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None, "not UTF-8"
    try:
        fields = next(csv.reader([text], delimiter="\t"))
    except (csv.Error, StopIteration) as error:
        return None, f"not TSV: {error}"
    if len(fields) != len(header):
        return None, f"{len(fields)} fields where its header has {len(header)}"
    return dict(zip(header, fields)), None


def parse_header(raw):
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None
    return text.split("\t") if text else None


def read_log():
    """Every session's entries in a content order no file name or arrival affects, and the lines skipped.

    An entry carries its parsed time as `at`. A skipped line is (file, line number, why).
    """
    entries, skipped = [], []
    paths = sorted(LOG_DIR.glob("*.tsv")) if LOG_DIR.is_dir() else []
    for path in paths:
        try:
            lines = split_lines(path.read_bytes())
        except OSError as error:
            skipped.append((path.name, 0, f"cannot read the file: {error.strerror}"))
            continue
        if not lines:
            continue
        header = parse_header(lines[0][1])
        if header is None:
            skipped.append((path.name, 1, f"no readable header, so its {len(lines) - 1} entries are skipped"))
            continue
        for number, raw in lines[1:]:
            if not raw:
                continue
            entry, why = parse_line(raw, header)
            if entry is None:
                skipped.append((path.name, number, why))
                continue
            for column in COLUMNS:
                entry[column] = entry.get(column) or ""
            entry["at"] = parse_time(entry["time"])
            if entry["at"] is None:
                skipped.append((path.name, number, f"time {entry['time']!r} does not parse"))
                continue
            entry["kind"] = entry["kind"] or "run"  # files from before baselines hold runs only
            entry["role"] = entry["role"] or "single"
            entries.append(entry)
    entries.sort(key=lambda e: (e["at"], e["kind"], e["row"], e["model"], e["level"], e["role"],
                                e["outcome"], e["note"], e["agent"]))
    return entries, skipped


def skipped_text(skipped):
    """One line naming every skipped log line, or None."""
    if not skipped:
        return None
    count = len(skipped)
    where = "; ".join(f"{file}:{number} ({why})" if number else f"{file} ({why})" for file, number, why in skipped)
    return f"skipped {count} log line{'s' if count != 1 else ''} that do{'es' if count == 1 else ''} not parse: {where}"


def tsv_line(fields):
    buffer = io.StringIO()
    csv.writer(buffer, delimiter="\t", lineterminator="\n").writerow(fields)
    return buffer.getvalue().encode("utf-8")


def append_entry(path, values):
    """Append one entry to a session's TSV, first moving a file with older columns onto COLUMNS.

    A line the move cannot parse is kept as it is, so it stays skipped rather than lost.
    """
    data = path.read_bytes() if path.exists() else b""
    lines = split_lines(data)
    header = parse_header(lines[0][1]) if lines else None
    if lines and header is None:
        fail(f"{path} has no readable header line; move the file aside to log from this session")
    if header and header[:len(COLUMNS)] != COLUMNS:
        moved = COLUMNS + [column for column in header if column not in COLUMNS]
        out = [tsv_line(moved)]
        for _, raw in lines[1:]:
            entry, _ = parse_line(raw, header)
            out.append(tsv_line([entry.get(column) or "" for column in moved]) if entry else raw + b"\n")
        write_atomically(path, b"".join(out))
        header = moved
        data = b"".join(out)
    prefix = b"\n" if data and not data.endswith(b"\n") else b""
    with path.open("ab") as handle:
        if not header:
            handle.write(tsv_line(COLUMNS))
        handle.write(prefix + tsv_line([values.get(column, "") for column in header or COLUMNS]))


def now():
    """The time an entry records: microseconds, so entries from two sessions in one second still order."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def session_log():
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session:
        fail("CLAUDE_CODE_SESSION_ID is not set; run this from a Claude Code session")
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    return session, LOG_DIR / f"{session}.tsv"


def workflow_agent(session, run_id, label):
    """The agentId of the agent() a Workflow run labeled `label`; main is never shown it."""
    records = list(PROJECTS.glob(f"*/{session}/workflows/{run_id}.json"))
    if len(records) != 1:
        fail(f"no single record for workflow run {run_id} in session {session} under {PROJECTS}")
    agents = [
        step for step in json.loads(records[0].read_text()).get("workflowProgress", [])
        if step.get("type") == "workflow_agent" and step.get("label") == label
    ]
    if len(agents) != 1:
        fail(f"workflow run {run_id} has {len(agents)} agents labeled '{label}'; a logged launch needs exactly one")
    if agents[0].get("cached"):
        fail(f"'{label}' in {run_id} reused an earlier run's result; log it from the run that did the work")
    return agents[0]["agentId"]


def measure_agent(session, agent_id, model):
    """One subagent run's requests, tool calls, tokens by kind, and time split, read from its transcript.

    Transcripts stay on the machine that ran them and are eventually cleaned
    up, so these columns are the only lasting record. The completion
    notification's token count is the final context size and its duration
    includes idle waits, so neither is recorded. Output counts appear to omit
    thinking. Idle is the wait after the run ended its turn until main or a
    peer resumed it; a wait for its own background task is tool time.
    """
    matches = list(PROJECTS.glob(f"*/{session}/subagents/**/agent-{agent_id}.jsonl"))
    if len(matches) != 1:
        fail(f"no single transcript for agent {agent_id} in session {session} under {PROJECTS}")
    with matches[0].open() as handle:
        entries = [json.loads(line) for line in handle]

    ran_on = {
        entry["message"]["model"] for entry in entries
        if entry.get("type") == "assistant" and entry["message"].get("model", "<synthetic>") != "<synthetic>"
    }
    if ran_on != {model}:
        fail(f"--model is {model}, but agent {agent_id}'s transcript ran on {', '.join(sorted(ran_on)) or 'nothing'}")

    # A request streams as several entries sharing one message id; each
    # field's largest value across them is the request's usage.
    requests = {}
    tool_calls = set()
    for entry in entries:
        message = entry.get("message")
        if not isinstance(message, dict):
            continue
        if isinstance(message.get("content"), list):
            tool_calls |= {block["id"] for block in message["content"] if block.get("type") == "tool_use"}
        usage = message.get("usage")
        if not usage:
            continue
        split = usage.get("cache_creation") or {}
        seen = {
            "input_tokens": usage.get("input_tokens") or 0,
            "output_tokens": usage.get("output_tokens") or 0,
            "cache_read_tokens": usage.get("cache_read_input_tokens") or 0,
            "cache_write_5m_tokens": split.get("ephemeral_5m_input_tokens", usage.get("cache_creation_input_tokens") or 0),
            "cache_write_1h_tokens": split.get("ephemeral_1h_input_tokens") or 0,
        }
        prior = requests.get(message.get("id"), {})
        requests[message.get("id")] = {k: max(v, prior.get(k, 0)) for k, v in seen.items()}

    secs = {"model_secs": 0.0, "tool_secs": 0.0, "idle_secs": 0.0}
    stamped = [e for e in entries if e.get("timestamp")]
    for before, after in zip(stamped, stamped[1:]):
        content = (before.get("message") or {}).get("content")
        turn_ended = before.get("type") == "assistant" and not (
            isinstance(content, list) and any(block.get("type") == "tool_use" for block in content))
        woken_by = (after.get("origin") or {}).get("kind")
        if after.get("type") == "assistant":
            bucket = "model_secs"
        elif turn_ended and woken_by != "task-notification":
            bucket = "idle_secs"
        else:
            bucket = "tool_secs"
        start = datetime.fromisoformat(before["timestamp"].replace("Z", "+00:00"))
        end = datetime.fromisoformat(after["timestamp"].replace("Z", "+00:00"))
        secs[bucket] += (end - start).total_seconds()

    totals = {k: sum(r[k] for r in requests.values()) for k in MEASURES[3:8]}
    return {
        "agent": agent_id, "requests": len(requests), "tool_calls": len(tool_calls),
        **totals, **{k: round(v) for k, v in secs.items()},
    }


def above(y, x):
    """Whether setting y is above setting x: no lower a model (fable ranks top), no lower a level, not equal."""
    return (y != x and MODELS.index(y[0]) >= MODELS.index(x[0])
            and LEVELS.index(y[1]) >= LEVELS.index(x[1]))


def dominates(y, x):
    return y == x or above(y, x)


def rung_up(setting):
    """One rung up: effort first, then the next model on the chain; None at the top of the row's ladder."""
    model, level = setting
    if level != ROW_LEVELS[-1]:
        return (model, ROW_LEVELS[ROW_LEVELS.index(level) + 1])
    if model in CHAIN[:-1]:
        return (CHAIN[CHAIN.index(model) + 1], level)
    return None


def rungs_down(setting):
    """The settings a step down may take, nearest first: effort down, then the model below."""
    model, level = setting
    rungs = []
    if level != ROW_LEVELS[0]:
        rungs.append((model, ROW_LEVELS[ROW_LEVELS.index(level) - 1]))
    if model in CHAIN[1:]:
        rungs.append((CHAIN[CHAIN.index(model) - 1], level))
    return rungs


def is_baseline(entry):
    return (entry["kind"] == "baseline" and entry["model"] in MODELS and entry["level"] in ROW_LEVELS
            and entry["role"] in BASELINE_ROLES)


def run_setting(entry):
    """The setting a judged run counts at, or None for an entry that is no evidence."""
    model = family(entry["model"])
    if (entry["kind"] != "run" or entry["outcome"] not in JUDGED or model not in MODELS
            or entry["level"] not in ROW_LEVELS):
        return None
    return (model, entry["level"])


class Evidence:
    """One row's evidence: its latest baseline and, per setting, its counted runs as (time, outcome) in order."""

    def __init__(self, baseline, entries):
        self.baseline = baseline
        self.runs = defaultdict(list)
        fresh = baseline["role"] == "fresh"
        for entry in entries:
            setting = run_setting(entry)
            if setting and not (fresh and entry["at"] <= baseline["at"]):
                self.runs[setting].append((entry["at"], entry["outcome"]))

    def misses(self, setting):
        return [at for at, outcome in self.runs[setting] if outcome == "missed"]

    def window(self, setting):
        return [outcome for _, outcome in self.runs[setting][-WINDOW:]]

    def failing(self, setting):
        runs = self.runs[setting]
        return bool(runs) and runs[-1][1] == "missed" and self.window(setting).count("missed") >= RAISE_AT

    def region(self, c, s):
        """The settings whose misses bear on a step from s down to c: those dominating c but not s."""
        return [y for y in SETTINGS if dominates(y, c) and not dominates(y, s)]

    def need(self, c, s):
        return STREAK * 2 ** sum(len(self.misses(y)) for y in self.region(c, s))

    def streak(self, s, c):
        """The met runs at s after the latest miss at s or in region(c, s)."""
        times = self.misses(s) + [at for y in self.region(c, s) for at in self.misses(y)]
        since = max(times) if times else None
        return sum(1 for at, outcome in self.runs[s] if outcome == "met" and (since is None or at > since))


def walk(evidence, oracle):
    """A row's setting from its evidence: up while failing, then (with an oracle) down while a streak pays."""
    setting = (evidence.baseline["model"], evidence.baseline["level"])
    path, reasons = [setting], []
    while evidence.failing(setting) and rung_up(setting):
        window = evidence.window(setting)
        reasons.append(f"{window.count('missed')} of the last {len(window)} runs at {name(setting)} missed")
        setting = rung_up(setting)
        path.append(setting)
    top = evidence.failing(setting)
    moved = oracle
    while moved:
        moved = False
        for rung in rungs_down(setting):
            streak, need = evidence.streak(setting, rung), evidence.need(rung, setting)
            if streak >= need:
                reasons.append(f"streak {streak} of {need}")
                setting = rung
                path.append(setting)
                moved = True
                break
    rungs = rungs_down(setting)
    streak = (f"{evidence.streak(setting, rungs[0])} of {evidence.need(rungs[0], setting)} for {name(rungs[0])}"
              if rungs and oracle else "-")
    if top:
        reason = TOP
    elif not oracle:
        reason = NO_ORACLE
    elif not rungs:
        reason = FLOOR
    else:
        reason = f"streak {streak}"
    window = evidence.window(setting)
    return {
        "setting": setting, "path": path, "streak": streak, "reason": reason,
        "misses": f"{window.count('missed')}/{len(window)}",
        # Why the row is where it is: the last step that put it there, or why it holds at its baseline.
        "why": reasons[-1] if reasons else reason,
    }


def walks(table, entries):
    """Every table row with a baseline → its walk."""
    baselines = {}
    by_row = defaultdict(list)
    for entry in entries:
        by_row[entry["row"]].append(entry)
        if is_baseline(entry):
            baselines[entry["row"]] = entry  # entries are in time order, so the last is the latest
    return {row: dict(walk(Evidence(baselines[row], by_row[row]), spec["oracle"]), baseline=baselines[row])
            for row, spec in table.items() if row in baselines}


def move_line(row, source, target, why):
    word = "STEP UP" if above(target, source) else "STEP DOWN" if above(source, target) else "MOVE"
    return f"{word}: {row} {name(source)} → {name(target)} ({why})"


def command_add(args):
    table = read_table()
    if args.row not in table:
        fail(f"unknown row '{args.row}'; add it to the task table first. Rows: {', '.join(table)}")
    if args.model.lower() in ALIASES or family(args.model) not in MODELS:
        fail(f"--model takes the exact model id (claude-<{'|'.join(MODELS)}>-…), not '{args.model}'")
    note = " ".join((args.note or "").split())
    if args.outcome == "brief" and not note:
        fail("--outcome brief takes --note: what the brief lacked")
    if bool(args.workflow) != bool(args.label):
        fail("--workflow and --label go together")
    session, path = session_log()
    agent_id = args.agent or workflow_agent(session, args.workflow, args.label)
    entries, _ = read_log()
    if any(entry["agent"] == agent_id for entry in entries):
        fail(f"agent {agent_id} is already logged; a launch is logged once, when its Done is judged")
    measured = measure_agent(session, agent_id, args.model)
    before = walks(table, entries).get(args.row)

    append_entry(path, {
        "time": now(), "kind": "run", "model": args.model, "row": args.row, "level": args.level,
        "role": args.role, "outcome": args.outcome, "note": note, **measured,
    })
    print(f"logged {args.row} {args.level} {args.role} {args.outcome}: {measured['requests']} requests, "
          f"{measured['model_secs']}s model, {measured['tool_secs']}s tools, {measured['idle_secs']}s idle")

    entries, skipped = read_log()
    after = walks(table, entries).get(args.row)
    if before is None or after is None:  # a run adds no baseline, so the two agree
        print(f"{args.row} has no setting yet: record one with effort-log baseline")
    else:
        ran_at = (family(args.model), args.level)
        if ran_at != before["setting"]:
            print(f"note: this run was at {name(ran_at)}; {args.row} is at {name(before['setting'])}")
        if after["setting"] != before["setting"]:
            print(move_line(args.row, before["setting"], after["setting"], after["why"]))
    if skipped:
        print(f"note: {skipped_text(skipped)}")


def table_setting(row, spec):
    """A row's Model and Effort cells as a setting; an Effort cell's `, unpaired` names no level."""
    model, effort = spec["model"], spec["effort"]
    if model is None or effort is None:
        fail(f"--from-table needs Model and Effort columns in the task table in {TABLE}")
    if effort.endswith(UNPAIRED):
        effort = effort[:-len(UNPAIRED)].strip()
    if model not in MODELS or effort not in ROW_LEVELS:
        fail(f"row `{row}` in {TABLE}: Model {model!r} and Effort {spec['effort']!r} are not a "
             f"setting ({'|'.join(MODELS)}, {'|'.join(ROW_LEVELS)})")
    return (model, effort)


def command_baseline(args):
    table = read_table()
    note = " ".join((args.note or "").split())
    if not note:
        fail("baseline takes --note: who set it and why")
    if args.from_table:
        if args.row or args.model or args.level:
            fail("--from-table takes every row's setting from the table; drop --row, --model and --level")
        settings = [(row, table_setting(row, spec)) for row, spec in table.items()]
    else:
        if not (args.row and args.model and args.level):
            fail("baseline takes --row, --model and --level, or --from-table")
        if args.row not in table:
            fail(f"unknown row '{args.row}'; add it to the task table first. Rows: {', '.join(table)}")
        if args.model not in MODELS:
            fail(f"--model takes a model family ({'|'.join(MODELS)}), not '{args.model}'")
        if args.level not in ROW_LEVELS:
            fail(f"--level takes a row level ({'|'.join(ROW_LEVELS)}), not '{args.level}'")
        settings = [(args.row, (args.model, args.level))]

    _, path = session_log()
    role = "carry" if args.carry else "fresh"
    for row, setting in settings:
        append_entry(path, {
            "time": now(), "kind": "baseline", "model": setting[0], "row": row, "level": setting[1],
            "role": role, "note": note,
        })
        print(f"baseline {row} {name(setting)} ({role})")
    entries, skipped = read_log()
    rows = walks(table, entries)
    for row, setting in settings:
        if rows[row]["setting"] != setting:
            print(move_line(row, setting, rows[row]["setting"], rows[row]["why"]))
    if skipped:
        print(f"note: {skipped_text(skipped)}")


def command_tally(args):
    table = read_table()
    entries, skipped = read_log()
    rows = walks(table, entries)
    lines = [["row", "oracle", "baseline", "setting", "misses", "streak", "path", "reason"]]
    for row, spec in table.items():
        oracle = "yes" if spec["oracle"] else "no"
        state = rows.get(row)
        if state is None:
            lines.append([row, oracle, "-", "no setting", "-", "-", "-", "no baseline"])
            continue
        base = state["baseline"]
        lines.append([row, oracle, f"{base['model']} {base['level']} {base['role']}", name(state["setting"]),
                      state["misses"], state["streak"], " → ".join(map(name, state["path"])), state["reason"]])
    widths = [max(len(line[column]) for line in lines) for column in range(len(lines[0]) - 1)]
    for line in lines:
        print("  ".join(cell.ljust(width) for cell, width in zip(line, widths)) + "  " + line[-1])

    runs = [e for e in entries if e["kind"] == "run"]
    for row in table:
        recent = [e for e in runs if e["row"] == row][-BRIEF_SPAN:]
        briefs = [e for e in recent if e["outcome"] == "brief"]
        if len(briefs) < BRIEF_AT:
            continue
        print(f"brief misses: {row} {len(briefs)} of the last {len(recent)} runs")
        for entry in briefs:
            if entry["note"]:
                print(f"  {row}: {entry['note']}")

    orphans = sorted({e["row"] for e in entries} - set(table))
    if orphans:
        print(f"logged rows no longer in the table: {', '.join(orphans)}")
    unset = [row for row in table if row not in rows]
    if unset:
        print(f"table rows with no baseline: {', '.join(unset)}")
    if skipped:
        print(skipped_text(skipped))


def settings_text():
    """What `settings` prints: every row's setting, or what keeps the log from giving them and what fixes it."""
    lead = "The task-table rows' current model and effort, from the effort log:"
    if store_missing():
        return f"The effort log sets no task-table row: {STORE_MISSING}."
    try:
        table = read_table()
    except Refusal as refusal:
        return f"The effort log sets no task-table row: {refusal}. Fix the task table in the user CLAUDE.md."
    entries, skipped = read_log()
    rows = walks(table, entries)
    if rows:
        lines = [lead, "", "| Row | Model | Effort |", "|---|---|---|"]
        lines += [f"| `{row}` | {rows[row]['setting'][0]} | {rows[row]['setting'][1]} |" for row in table if row in rows]
        unset = [row for row in table if row not in rows]
        if unset:
            lines += ["", "No setting in the effort log yet: " + ", ".join(f"`{row}`" for row in unset) + "."]
    else:
        lines = [f"The effort log sets no task-table row: {NO_BASELINE}."]
    if skipped:
        lines += ["", f"The effort log {skipped_text(skipped)}."]
    return "\n".join(lines)


def command_settings(args):
    # A SessionStart hook must never break a session, and must never go silent: every failure is named.
    try:
        text = settings_text()
    except Exception as error:  # noqa: BLE001
        text = (f"The effort log sets no task-table row: it failed ({type(error).__name__}: {error}); "
                f"run effort-log tally to see the problem.")
    print(text)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)

    add = commands.add_parser("add", help="record one judged launch, and report when it moves its row")
    add.add_argument("--row", required=True, help="task-table row key")
    add.add_argument("--level", required=True, choices=LEVELS, help="effort the run used")
    add.add_argument("--outcome", required=True, choices=OUTCOMES)
    add.add_argument("--model", required=True, help="exact model id the subagent ran on")
    add.add_argument("--role", default="single", choices=ROLES,
                     help="escalation for the rerun a level up after a miss")
    add.add_argument("--note", help="what the brief lacked (required with --outcome brief)")
    launch = add.add_mutually_exclusive_group(required=True)
    launch.add_argument("--agent", help="the agentId an Agent launch returned; its transcript supplies the recorded measures")
    launch.add_argument("--workflow", help="the Run ID of the Workflow whose agent() this was; pair with --label")
    add.add_argument("--label", help="the label the Workflow script gave that agent()")
    add.set_defaults(handler=command_add)

    baseline = commands.add_parser("baseline", help="set a row's model and effort (or every row's, from the table)")
    baseline.add_argument("--row", help="task-table row key")
    baseline.add_argument("--model", help=f"model family: {', '.join(MODELS)}")
    baseline.add_argument("--level", help=f"effort level: {', '.join(ROW_LEVELS)}")
    baseline.add_argument("--from-table", action="store_true",
                          help="one baseline per table row, from its Model and Effort cells")
    baseline.add_argument("--note", help="who set it and why")
    baseline.add_argument("--carry", action="store_true",
                          help="count the row's earlier runs too (default: only runs after the baseline)")
    baseline.set_defaults(handler=command_baseline)

    tally = commands.add_parser("tally", help="every row's setting, how the log reached it, and rows with recurring brief misses")
    tally.set_defaults(handler=command_tally)

    settings = commands.add_parser("settings", help="every row's current setting as markdown, for a SessionStart hook")
    settings.set_defaults(handler=command_settings)

    args = parser.parse_args()
    try:
        if args.command != "settings" and store_missing():
            fail(STORE_MISSING)
        args.handler(args)
    except Refusal as refusal:
        print(f"effort-log: {refusal}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
